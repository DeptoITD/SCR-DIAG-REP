# Configuración Servidores
# =========================

# Rutas (agnósticas, funcionan cualquier máquina)
REPO_PATH="/opt/scripts/SCR-DIAG-REP"
EXPORT_PATH="${REPO_PATH}/src/export"
LOG_DIR="${REPO_PATH}/logs"
DATA_DIR="${REPO_PATH}/config/data"

# Log file (definido por script antes de sourcear utils.sh)
# LOG_FILE="${LOG_DIR}/script_$(date +%Y%m%d_%H%M%S).log"

# NAS Configuración (replicación centralizada)
NAS_MOUNT_POINT="/mnt/nas"
NAS_EXPORT_PATH="${NAS_MOUNT_POINT}/SCR-DIAG-REP/exports"
NAS_ENABLED=true
NAS_SYNC_TIMEOUT=300  # segundos
