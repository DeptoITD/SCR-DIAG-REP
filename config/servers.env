# Configuración Servidores
# =========================

# Servidor origen (exporta identidades)
SERVIDOR_ORIGEN_IP="192.168.x.x"
SERVIDOR_ORIGEN_USER="root"
SERVIDOR_ORIGEN_SSH_KEY="/root/.ssh/id_rsa"
SERVIDOR_ORIGEN_PATH="/opt/scripts/SCR-DIAG-REP"

# NAS destino (recibe identidades)
NAS_IP="192.168.x.x"
NAS_USER="soporte"
NAS_SSH_KEY="/home/soporte/.ssh/id_rsa"
NAS_PATH="/opt/scripts/SCR-DIAG-REP"

# Rutas export
EXPORT_PATH="${NAS_PATH}/src/export"
EXPORT_GROUP="${EXPORT_PATH}/$(hostname)_group.txt"
EXPORT_PASSWD="${EXPORT_PATH}/$(hostname)_passwd.txt"
EXPORT_SAMBA_USERS="${EXPORT_PATH}/$(hostname)_samba_users.txt"
EXPORT_SMBPASSWD="${EXPORT_PATH}/$(hostname)_smbpasswd.exp"

# Logs
LOG_DIR="${NAS_PATH}/logs"
LOG_FILE="${LOG_DIR}/$(date +%Y%m%d_%H%M%S).log"

# Samba
SAMBA_PASSWORD="sambapass123"  # Cambiar para producción
